{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npx next build",
  "devCommand": "npx next dev",
  "crons": [
    {
      "path": "/api/cron/sync-squads",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-stats",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 6 * * *"
    }
  ]
}
